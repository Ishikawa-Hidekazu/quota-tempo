{
  "manifest_version": 3,
  "name": "QuotaTempo Claude Bridge (Prototype)",
  "version": "0.1.1",
  "description": "Opt-in Claude usage observation for a local QuotaTempo native host.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "QuotaTempo bridge" }
}
